# Required API keys for Approved LLM providers (fill in local .env only)
ANTHROPIC_API_KEY=replace_with_your_key # required

# Telegram bot token and admin user ID
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_USER_ID=replace_with_your_telegram_user_id

# Vodokanal cabinet credentials
VODOKAN_LOGIN=replace_with_login
VODOKAN_PASSWORD=replace_with_password

# Account details
ACCOUNT_ID=acc1
COUNTER_CODE=replace_with_counter_code
ID_DB=1

# Scheduler configuration
TZ=Europe/Moscow
WINDOW_START=1
WINDOW_END=25
REMINDER_START_DAY=18
REMINDER_TIME=09:00
EVENING_TIME=19:00
EVENING_FROM_DAY=22

# Anomaly thresholds
ANOMALY_FACTOR=2.0
CONFIDENCE_MIN=0.9

# Modes
# DRY_RUN=true — no real requests to Vodokanal/Anthropic (recommended for dev)
DRY_RUN=false
AUTO_SEND=false

# Whitelist (comma-separated user IDs, optional)
WHITELISTED_USERS=